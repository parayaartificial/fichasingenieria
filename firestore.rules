rules_version = '2';

// ============================================================
// REGLAS DE SEGURIDAD FIRESTORE - Informes de Emergencia
// Ingeniería Municipal · Concepción
//
// ⚠️ La aplicación autentica usuarios con login propio
// (localStorage + colección "usuarios"), NO usa Firebase
// Authentication. Por eso estas reglas permiten leer/escribir
// a cualquier cliente, con validación de estructura/tamaños.
// ⚠️ Aviso de seguridad: con esto los datos quedan accesibles
// para cualquiera que conozca el projectId. Si la app migra a
// Firebase Authentication, restringir con request.auth.
//
// Despliegue con:  firebase deploy --only firestore:rules
// ============================================================

service cloud.firestore {
  match /databases/{database}/documents {

    // --- Fichas de emergencia ---------------------------------
    match /fichas/{fichaId} {
      allow read: if true;

      // Validación laxa (para no rechazar informes antiguos):
      // limita tamaño y los campos sensibles si están presentes.
      function valido() {
        let d = request.resource.data;
        return d is map
          && d.keys().size() <= 45
          && (!('registroNum' in d) ||
              (d.registroNum is int && d.registroNum > 0 && d.registroNum < 100000))
          && (!('prioridad' in d) || d.prioridad in ['', 'alta', 'media', 'baja'])
          && (!('sector' in d) || (d.sector is string && d.sector.size() <= 200))
          && (!('calle' in d) || (d.calle is string && d.calle.size() <= 300))
          && (!('descripcion' in d) || (d.descripcion is string && d.descripcion.size() <= 50000))
          && (!('conclusion' in d) || (d.conclusion is string && d.conclusion.size() <= 50000))
          && (!('ubicacionGeo' in d) || (d.ubicacionGeo is string && d.ubicacionGeo.size() <= 2000))
          && (!('codigoSeguimiento' in d) || (d.codigoSeguimiento is string && d.codigoSeguimiento.size() <= 30))
          && (!('imagenesAntes' in d) || (d.imagenesAntes is list && d.imagenesAntes.size() <= 25))
          && (!('imagenesDespues' in d) || (d.imagenesDespues is list && d.imagenesDespues.size() <= 25))
          && (!('imagenes' in d) || (d.imagenes is list && d.imagenes.size() <= 25));
      }

      allow create: if valido();
      allow update: if valido()
        && request.resource.data.keys().hasAll(['id', 'fechaCreacion']);
      allow delete: if true;
    }

    // --- Usuarios de la app ----------------------------------------
    match /usuarios/{usuario} {
      function validoUsuario() {
        let d = request.resource.data;
        return d is map
          && d.keys().size() <= 20
          && 'login' in d && d.login is string && d.login.size() <= 60
          && 'name' in d && d.name is string && d.name.size() <= 150
          && 'role' in d && d.role in ['admin', 'creador', 'editor']
          && 'pass' in d && d.pass is string && d.pass.size() <= 80
          && (!('initPass' in d) || (d.initPass is string && d.initPass.size() <= 80));
      }

      allow read: if true;
      allow create: if validoUsuario();
      allow update: if validoUsuario();
      allow delete: if true;
    }

    // --- Negar el resto por defecto ----------------------------
    match /{document=**} {
      allow read, write: if false;
    }
  }
}